# ===== 密钥（二选一，不要提交到 git / 不要截图）=====

# 方式一（推荐）：元宝搜索「服务 API KEY」（sk- 开头，控制台获取）
# 零依赖直连，无需安装 SDK
YUANBAO_API_KEY=

# 方式二：腾讯云 AK/SK 签名（需 pip install -r requirements.txt）
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=

# ===== 运行配置 =====

# 强制 mock 模式（无任何密钥时自动开启；设为 1 可强制）
MOCK=0

# 服务器部署时：监听公网需要改为 0.0.0.0
HOST=127.0.0.1

# 每日实时检索报告上限（核销邀请码后月额度为 6000 次）
DAILY_LIMIT=60

# 同一机型行情检索的缓存时长（秒）
CACHE_TTL=3600

# ===== 在线加固 =====

# 每 IP 每 60 秒允许的 POST 请求数（仅限 /api/advise 与 /api/search）
RATE_LIMIT_PER_MIN=20

# 单次请求体大小上限（字节）
MAX_BODY_BYTES=65536
